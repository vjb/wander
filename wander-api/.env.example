# API key for OpenAI GPT model inference (required)
# Format: sk-proj-...
OPENAI_API_KEY="sk-proj-placeholder"

# API key for Google Maps Platform services (required)
# Services that must be enabled: Places API (New), Geocoding API, Directions API
# Format: AIzaSy...
GOOGLE_MAPS_API_KEY="AIzaSyPlaceholder"

# API key for OpenWeatherMap weather context retrieval (required)
# Format: 32-character hexadecimal string
OPENWEATHER_API_KEY="placeholder_weather_key"

# API key for Tavily Search API (optional)
# Format: tvly-...
TAVILY_API_KEY="tvly-placeholder"

# LangSmith tracing toggle (optional)
# Format: "true" or "false"
LANGCHAIN_TRACING_V2="false"

# API key for LangSmith logging (optional)
# Format: lsv2_...
LANGCHAIN_API_KEY="lsv2_placeholder"
